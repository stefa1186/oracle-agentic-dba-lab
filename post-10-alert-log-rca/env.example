# =============================================================================
# Post 10 settings (defaults). To change one, copy this file to .env in the
# same folder and edit it there; .env is read after this file and is never
# committed.
# =============================================================================

# The application user of the incident: owns the shop's STOCK and ORDERS
# tables, and its sessions cause the incident. Its password is generated by
# 02_create_incident.sh for that run only, passed through stdin, never stored,
# and the account is locked as soon as the sessions are connected.
# 99_cleanup.sh drops it.
SHOP_SCHEMA=SHOP_APP

# How long the incident lasts if nobody ends it: the victim session keeps its
# transaction open this many minutes, and every session behind it waits.
# Long enough for an investigation with a human approving every step (the
# first run took 71 minutes: the 30 of the first version ran out mid-run).
INCIDENT_MINUTES=60

# Users who try to place an order for the same item while it's locked: the
# pile-up behind the stuck session (what the users notice: "it's frozen").
PILEUP_SESSIONS=3

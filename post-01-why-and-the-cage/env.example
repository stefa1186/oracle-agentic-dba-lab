# -----------------------------------------------------------------------------
# Settings for the post 01 lab scripts.
#
# The scripts always read this file for defaults. To change a value, copy it:
#   cp env.example .env
# and edit .env. Values in .env override the ones here. .env is ignored by git.
#
# There are no passwords here: the database password is generated on first
# build and stored only on the server (see DB_PASSWORD_FILE below).
# -----------------------------------------------------------------------------

# ---- The lab user ------------------------------------------------------------

# Dedicated Linux user that owns the whole lab: containers, data, agent.
# Oracle analogy: the "oracle" OS user. Nothing else runs as this user, and
# nothing in the lab runs as root.
# Created by 00_root_setup.sh. If you change it, use the same value in the
# copy root runs and in the lab user's own copy of the repository.
LAB_USER=oralab

# ---- The database container --------------------------------------------------

# Oracle AI Database 26ai Free image from Oracle's container registry,
# PINNED by digest: every build uses exactly this image, even after Oracle
# moves the "latest" tag. Like staying on a specific Release Update.
# Pinned on 2026-11-04 from the full image (tag "latest" at that time).
# To upgrade deliberately: podman pull ...free:latest, read the new digest
# (RepoDigests), replace it here, commit, then rerun ./02_build.sh.
DB_IMAGE=container-registry.oracle.com/database/free@sha256:c4d9b15a1b2240ce90730c23ce298fcdd34f6793792c1b3849181a080009c322

# Container name (the "instance").
DB_CONTAINER=oralab-db

# Dedicated container network: the lab's own private segment.
DB_NETWORK=oralab-net

# Named volume holding the datafiles (/opt/oracle/oradata in the container).
# It survives container restarts and rebuilds until 99_destroy.sh removes it.
DB_VOLUME=oralab-oradata

# Name of the Podman secret holding the database password.
DB_SECRET=oralab_oracle_pwd

# Host port for the listener. Published on 127.0.0.1 only: like a listener
# with HOST=localhost, nothing outside this server can connect.
DB_PORT=1521

# Container resource limits. Oracle Free uses at most 2 CPU threads and 2 GB
# of RAM for the database itself; the container needs some headroom on top.
DB_MEMORY=4g
DB_CPUS=2

# Seconds to wait for the database to open. The first build creates the
# database from scratch and can take 10-20 minutes on modest hardware.
DB_READY_TIMEOUT=1800

# ---- Outbound network policy for the lab user ---------------------------------

# Space-separated TCP ports the lab user may connect to on the internet.
# 443 covers the container registry, Python packages, SQLcl downloads and
# OpenRouter. Name resolution goes only to this server's own DNS servers
# (/etc/resolv.conf). Everything else is dropped.
# Applied by 00_root_setup.sh (root): the lab user can't change its own policy.
# To change it, edit this value and rerun "sudo ./00_root_setup.sh".
EGRESS_ALLOWED_TCP_PORTS="443"

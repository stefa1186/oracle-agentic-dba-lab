# -----------------------------------------------------------------------------
# Settings for post 13. The scripts always read this file; to change a value,
# copy it to .env and edit .env (never committed).
# -----------------------------------------------------------------------------

# Oracle's sample schemas (SH lives in them), pinned to a release, and the
# SHA-256 of that archive. If the archive ever changes, 01_setup.sh stops.
SAMPLES_URL=https://codeload.github.com/oracle-samples/db-sample-schemas/tar.gz/refs/tags/v23.3
SAMPLES_SHA256=94d47c97fb71227f88bfc01100b07de4622d7db592dec74f2d581f4fb9cbe509

# The read-only user the generated SQL runs as: SELECT on SH, nothing else.
RO_USER=NL2SQL_RO

# How many times each question is asked, per model and metadata level.
# The models are in models.txt.
REPEATS=3

# =============================================================================
# Post 07 settings (defaults). To change one, copy this file to .env in the
# same folder and edit it there; .env is read after this file and is never
# committed.
# =============================================================================

# The application user that owns the table and runs the slow query. Its
# password is generated by 01_setup.sh and kept in TUNE_PWD_FILE (mode 600)
# until 99_cleanup.sh drops the user and deletes the file.
TUNE_SCHEMA=TUNE_LAB

# Rows in TUNE_LAB.ORDERS: 1,000 orders a day, so this many days of data.
TUNE_ROWS=1000000

# Every measurement runs the query this many times and reports the LAST run
# (warm cache, the plan already chosen): buffer gets are then comparable.
MEASURE_RUNS=3

# SQL Tuning Advisor's time limit for its analysis, in seconds.
STA_TIME_LIMIT=120

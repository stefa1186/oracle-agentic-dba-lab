# =============================================================================
# Post 12 settings (defaults). To change one, copy this file to .env in the
# same folder and edit it there; .env is read after this file and is never
# committed.
# =============================================================================

# The cloud model for the baseline: the model of the whole series, through
# OpenRouter (needs internet, and OPENROUTER_API_KEY in agent-harness/.env).
CLOUD_MODELS="nvidia/nemotron-3-ultra-550b-a55b:free"

# The local models to test, as Ollama tags, separated by spaces. Each one must
# have a line in model_pins.txt (its exact digest and size). The default: the
# smallest members of the cloud model's own family, NVIDIA Nemotron 3 Nano,
# at 4 billion parameters and at 30 billion (3 billion active).
# If 01_check_hardware.sh says a model doesn't fit this server, list only the
# ones that do, in .env, e.g.:  LOCAL_MODELS="nemotron-3-nano:4b-q4_K_M"
# Another family, also pinned: LOCAL_MODELS="qwen3.6:35b-a3b" (Alibaba's
# Qwen3.6, 35B in total, 3B active, like the 30B Nemotron).
# The search for the best local model for the job (the article), also pinned:
#   LOCAL_MODELS="gpt-oss:20b gemma4:26b qwen3-coder:30b qwen3.8:27b"
#   for 01, 02 and 04; then 05 twice, since gpt-oss can't switch its
#   thinking off (its lowest level is "low"):
#   LOCAL_MODELS="gpt-oss:20b"  with  TEST_LOCAL_REASONING_EFFORT="low"
#   LOCAL_MODELS="gemma4:26b qwen3-coder:30b"  (thinking off, the default)
#   qwen3.8:27b is a dense model: 04 measures its speed (2.8 tokens/s on the
#   lab's CPU), too slow for the full tests.
LOCAL_MODELS="nemotron-3-nano:4b-q4_K_M nemotron-3-nano:30b-a3b-q4_K_M"

# Harness limits for EVERY run of this post, cloud and local alike, so the
# comparison is fair. Passed through the environment (they win over
# agent-harness/.env for these runs only).
#   Tool output: at most this many characters per tool result reach the model
#   (a small model's memory for the conversation is limited; see the article).
TEST_MAX_TOOL_OUTPUT_CHARS=8000
#   Steps: at most this many model calls per run.
TEST_MAX_STEPS=20
#   Seconds to wait for ONE model answer. A large local model on a CPU can
#   take minutes for one long answer.
TEST_REQUEST_TIMEOUT=1800
#   Extra attempts after a temporary error, for LOCAL models only. The cloud
#   runs keep the harness's own setting (MODEL_RETRIES in agent-harness/.env):
#   a busy cloud endpoint often answers on the next try. A local model that
#   timed out on a CPU won't be faster the second time: 0 retries.
TEST_LOCAL_MODEL_RETRIES=0
#   Thinking (the harness's REASONING_EFFORT): how much a reasoning model may
#   think before each answer. Empty = the server's default.
#   The cloud model keeps its endpoint's default, as in the whole series. It
#   thinks very little there: 50 to 270 tokens for each step of test A.
TEST_CLOUD_REASONING_EFFORT=""
#   The local models think with it switched off. Ollama's default lets the
#   Nano models think without limit: on this lab's CPU, the 4B thought for
#   about 9,000 tokens on the first step of test A and ran into the
#   30-minute timeout. NVIDIA recommends greedy decoding (temperature 0, the
#   series' setting) precisely for thinking off.
TEST_LOCAL_REASONING_EFFORT="none"

# RAM check (01_check_hardware.sh): a model needs about its file size, plus
# this share for its working memory, plus 1 GiB. Kept simple on purpose.
RAM_FACTOR_PERCENT=110

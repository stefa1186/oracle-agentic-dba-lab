# =============================================================================
# Post 06 settings (defaults). To change one, copy this file to .env in the
# same folder and edit it there; .env is read after this file and is never
# committed.
# =============================================================================

# Schema that owns the workload's tables and jobs. Created as a schema-only
# account (NO AUTHENTICATION: nobody can log in as it) and dropped by 99_cleanup.sh.
AWR_SCHEMA=AWR_LOAD

# How long the workload runs between the two AWR snapshots, in seconds.
AWR_LOAD_SECONDS=180

# Problem 1, row lock contention: one session holds a lock on the same row for
# AWR_LOCK_HOLD_SECONDS at a time, AWR_LOCK_WAITERS sessions keep queuing for it.
AWR_LOCK_WAITERS=4
AWR_LOCK_HOLD_SECONDS=5

# Problem 2, hard parsing: sessions running the same query with a different
# literal every time, so every execution is a new cursor.
AWR_LITERAL_SESSIONS=2

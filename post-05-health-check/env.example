# =============================================================================
# Post 05 settings (defaults). To change one, copy this file to .env in the
# same folder and edit it there; .env is read after this file and is never
# committed.
# =============================================================================

# Schema that owns the seeded problems. Created as a schema-only account (NO
# AUTHENTICATION: nobody can log in as it) and dropped by 99_cleanup.sh.
HC_SCHEMA=HC_SEED

# The seeded security finding: a schema-only account (no login possible)
# that holds the DBA role.
HC_LEGACY_USER=HC_LEGACY

# Small tablespace the seed fills: autoextend off, so "nearly full" is real.
HC_TABLESPACE=HC_SMALL
# Its size in MB.
HC_TS_SIZE_MB=20
# How full the seed makes it, in percent (filled in 1 MB extents, so the
# result lands at or just above this value).
HC_TS_TARGET_PCT=90

# Thresholds used by the DBA checklist (03_dba_checklist.sh).
# A tablespace at or above this percentage used is a finding.
HC_TS_WARN_PCT=85
# A recovery area at or above this percentage used (net of reclaimable space) is a finding.
HC_FRA_WARN_PCT=80
# No successful RMAN backup within this many days is a finding.
HC_BACKUP_MAX_AGE_DAYS=7

# -----------------------------------------------------------------------------
# Agent harness settings. Copy to .env (same folder) and edit:
#   cp env.example .env && chmod 600 .env
# .env is ignored by git. Treat it like a password file: it holds your API key.
# -----------------------------------------------------------------------------

# ---- Defaults used when --provider / --model are not given ------------------

# Which provider to use by default: openrouter or local.
DEFAULT_PROVIDER=openrouter

# Model used when --model is not given, at the default provider.
# List them with: .venv/bin/python run_agent.py --provider <provider> --list-models
DEFAULT_MODEL=

# ---- Provider: openrouter (hosted models) -----------------------------------

# Your OpenRouter API key (https://openrouter.ai/keys).
# Tip: create a dedicated key for this lab with a low credit limit, so a
# runaway agent loop can't spend more than you intend (a profile for your wallet).
OPENROUTER_API_KEY=

# ---- Provider: local (models running on this server) ------------------------

# OpenAI-compatible endpoint of the local model server. The default matches the
# Ollama container started by local-models/01_start_ollama.sh. Examples:
#   Ollama:            http://127.0.0.1:11434/v1
#   vLLM:              http://127.0.0.1:8000/v1
#   llama.cpp server:  http://127.0.0.1:8080/v1
LOCAL_BASE_URL=http://127.0.0.1:11434/v1

# Most local servers ignore the key; set one only if your server requires it.
LOCAL_API_KEY=local

# ---- MCP server --------------------------------------------------------------

# Path to the SQLcl launcher. The MCP server is SQLcl started with "-mcp".
SQLCL_BIN=sql

# SQLcl restrict level for the MCP server (0 = unrestricted ... 4 = most
# restricted). Always passed explicitly: since SQLcl 26.1.2 MCP mode starts
# UNRESTRICTED by default, which would let the agent run OS commands as the
# lab user. 4 blocks host commands, scripts and other sensitive operations.
SQLCL_RESTRICT=4

# ---- Limits (apply to every provider) ----------------------------------------

# Maximum model calls per run. Bounds runaway loops, like CPU_PER_CALL in a profile.
MAX_STEPS=20

# Sampling temperature. 0 gives the most repeatable answers a provider allows.
TEMPERATURE=0

# Largest tool result (characters) passed back to the model; longer output is truncated.
# Small local models have small context windows: lower this (e.g. 8000) if they lose track.
MAX_TOOL_OUTPUT_CHARS=20000

# Seconds to wait for one model answer. Local models on CPU can be slow.
REQUEST_TIMEOUT=600

# Extra attempts after a TEMPORARY provider error (timeout, connection error,
# rate limit, provider failure), waiting 15, 30, 60 ... seconds in between.
# Every failed attempt is logged as a "model_error" event. 0 = no retries.
# If every attempt fails, the run ends as "model_error" with exit code 1.
MODEL_RETRIES=3

# How much a reasoning model may think before it answers, sent as the
# OpenAI-style "reasoning_effort" field with every model call: none, low,
# medium or high, for servers that accept it. EMPTY (the default) sends
# nothing: the model thinks as its server decides, as in posts 01 to 11.
# Ollama lets a thinking model think without limit unless this is "none"
# (post 12: on a CPU, one step of a 4B model ran past 30 minutes).
REASONING_EFFORT=

# Comma-separated MCP tools the agent may use; the model never sees the others.
# Safe by default: EMPTY means the built-in read-oriented list
#   connections_list,connect,disconnect,sql_run,schema_information,request_status
# which leaves out sqlcl_run (any SQLcl command), skills_sync (downloads files
# into the home folder), annotation_generate (writes into the database) and
# context_retrieve (vector search, post 08). Write ALL to allow every tool.
# Check what the agent will see with: .venv/bin/python run_agent.py --list-tools
ALLOWED_TOOLS=

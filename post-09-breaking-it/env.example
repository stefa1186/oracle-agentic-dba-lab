# =============================================================================
# Post 09 settings (defaults). To change one, copy this file to .env in the
# same folder and edit it there; .env is read after this file and is never
# committed.
# =============================================================================

# The schema that owns the ticket table the agent reads in attack 2. Created
# with NO AUTHENTICATION: nobody can log in as it, so it needs no password.
# 99_cleanup.sh drops it.
INJ_SCHEMA=INJ_LAB

# The ticket table, in INJ_SCHEMA. One of its rows carries the hidden instruction.
INJ_TABLE=DBA_TICKETS

# The firewall bypass test (06_firewall_bypass.sh) proves that a statement ran
# by making it sleep: if the call takes at least this many seconds, the
# statement inside it was executed. Long enough to stand out from normal
# call times (well under a second on the lab), short enough not to bore you.
BYPASS_SLEEP_SECONDS=5

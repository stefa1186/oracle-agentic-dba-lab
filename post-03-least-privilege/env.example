# -----------------------------------------------------------------------------
# Settings for the post 03 scripts (least privilege for the agent).
#
# The scripts always read this file for defaults. To change a value, copy it:
#   cp env.example .env
# and edit .env. Values in .env override the ones here. .env is ignored by git.
# Lab, database, SQLcl and agent settings come from posts 01 and 02.
# -----------------------------------------------------------------------------

# Role holding the agent's object grants: exactly the views in
# granted_views.txt, rebuilt from scratch on every run of 01_least_privilege.sh.
# Oracle analogy: an application role, instead of grants scattered on the user.
AGENT_ROLE=AI_AGENT_READ

# Profile limiting the agent's sessions and calls, so a runaway loop hits a
# wall instead of the server. Oracle analogy: exactly what profiles are for.
AGENT_PROFILE=AI_AGENT_PROFILE

# Concurrent sessions for the agent's user.
PROFILE_SESSIONS_PER_USER=2
# CPU per call, in hundredths of a second (3000 = 30 seconds).
PROFILE_CPU_PER_CALL=3000
# Logical reads (blocks) per call.
PROFILE_LOGICAL_READS_PER_CALL=1000000
# Minutes of inactivity before the session is ended.
PROFILE_IDLE_TIME=15
# Minutes a session may stay connected in total.
PROFILE_CONNECT_TIME=120
# Failed logins before the account locks.
PROFILE_FAILED_LOGIN_ATTEMPTS=5

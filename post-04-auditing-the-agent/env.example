# -----------------------------------------------------------------------------
# Settings for the post 04 scripts (auditing the agent).
#
# The scripts always read this file for defaults. To change a value, copy it:
#   cp env.example .env
# and edit .env. Values in .env override the ones here. .env is ignored by git.
# Lab, database, SQLcl, agent and privilege settings come from posts 01-03.
# -----------------------------------------------------------------------------

# Unified Auditing policy that records EVERY action of the agent's user:
# every statement, successful or failed, plus logon and logoff. The audit
# trail is owned by the database (AUDSYS); the agent can neither read nor
# change it. Oracle analogy: the redo log of who-did-what.
AUDIT_POLICY=AI_AGENT_ALL_ACTIONS

# Seconds added before and after a harness run when matching its audit
# records by time (clock rounding between the harness and the database).
AUDIT_WINDOW_MARGIN=5

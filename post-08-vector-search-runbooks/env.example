# =============================================================================
# Post 08 settings (defaults). To change one, copy this file to .env in the
# same folder and edit it there; .env is read after this file and is never
# committed.
# =============================================================================

# The application user that owns the runbook table and the embedding model.
# Its password is generated by 02_setup.sh and kept in RAG_PWD_FILE (mode
# 600) until 99_cleanup.sh drops the user and deletes the file.
RAG_SCHEMA=RAG_LAB

# Oracle's prebuilt embedding model (all-MiniLM-L12-v2, augmented with its
# tokenizer, ONNX format), from Oracle's blog "Use our prebuilt ONNX model now
# available for embedding generation in Oracle Database 23ai".
MODEL_URL=https://adwc4pm.objectstorage.us-ashburn-1.oci.customer-oci.com/p/TtH6hL2y25EypZ0-rrczRZ1aXp7v1ONbRBfCiT-BDBN8WLKQ3lgyW6RxCfIFLdA6/n/adwc4pm/b/OML-ai-models/o/all_MiniLM_L12_v2_augmented.zip
# The ONNX file inside the zip.
MODEL_FILE=all_MiniLM_L12_v2.onnx
# SHA-256 of the zip. Oracle publishes none: this is the one downloaded and
# tested on 2026-11-05. If Oracle replaces the file, 01_get_model.sh stops;
# check the new one, then set MODEL_SHA256 in .env.
MODEL_SHA256=f49a7a5e4d8bddf492e4212428961ae9e01c0ce49d2ad312d0d982279bb7ec39
# Where the zip and the ONNX file are kept on the server (outside the repository).
MODEL_DIR=${HOME}/opt/models/all_MiniLM_L12_v2
# The model's name in the database.
MODEL_NAME=RUNBOOK_EMBEDDER

# How many runbook chunks the search returns, and the agent gets.
TOP_K=3

# -----------------------------------------------------------------------------
# Settings for the post 02 scripts (SQLcl and the agent's connection).
#
# The scripts always read this file for defaults. To change a value, copy it:
#   cp env.example .env
# and edit .env. Values in .env override the ones here. .env is ignored by git.
# The lab and database settings come from post-01-why-and-the-cage/env.example.
# -----------------------------------------------------------------------------

# ---- SQLcl ------------------------------------------------------------------

# Where SQLcl is downloaded from: the VERSIONED file of the release in use,
# 26.3.1.301.1413. Oracle also publishes the current release as
# sqlcl-latest.zip, but that file changes with every release, and a fresh
# install would then fail the checksum below. The versioned file never changes.
SQLCL_URL=https://download.oracle.com/otn_software/java/sqldeveloper/sqlcl-26.3.1.301.1413.zip

# SHA-256 of the SQLcl zip in use, PINNED: the install only accepts this exact
# file, like pinning the database image by digest. Every reinstall uses the
# cached copy in ~/.cache/oralab/sqlcl.zip.
# Pinned on 2026-11-04; verified again on 2026-11-05 against the versioned URL.
# To upgrade deliberately: put the new release's versioned URL above, delete
# the cached zip, empty this value, run ./01_install_sqlcl.sh, pin the new
# checksum it prints, commit.
SQLCL_SHA256=f3f188ae06f17eb181f77ae0be54f2ae8c165e52056a7cb7401a974cace9e5f2

# Install folder (inside the lab user's home; nothing system-wide).
SQLCL_DIR="${HOME}/opt/sqlcl"

# Restrict level used by the checks here (the harness has its own setting,
# SQLCL_RESTRICT in agent-harness/.env, with the same default).
# 4 = most restrictive: no host commands, no scripts.
SQLCL_RESTRICT=4

# ---- The agent's database account --------------------------------------------

# Database user the agent connects as, in FREEPDB1. In this post it gets
# CREATE SESSION plus SELECT_CATALOG_ROLE: deliberately a little generous, so
# post 03 has something to take away.
AGENT_DB_USER=AI_AGENT

# Name of the saved SQLcl connection the agent uses through MCP.
# The password is stored in SQLcl's connection store, never shown to the model.
MCP_CONNECTION=agent
